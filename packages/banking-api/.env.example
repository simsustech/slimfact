# banking-api — required
# Hostname this instance is reached at. Must match SlimFact's BANKING_API_URL,
# or OIDC and event-bus origins disagree. A bare host, not a URL.
API_HOST=banking-api

# Postgres (the proxy keeps its own `open_banking` schema; sharing SlimFact's
# database is the default, a separate one also works)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=slimfact

# open-banking.io credentials (base64 JSON bundle incl. P-256 decryption key)
OPENBANKING_CREDENTIALS_JSON=
OPENBANKING_API_BASE_URL=
OPENBANKING_SYNC_CRON=0 */4 7-23 * * *
OPENBANKING_SYNC_COOLDOWN_SECONDS=60
OPENBANKING_MIN_SYNC_INTERVAL_SECONDS=60

# API key config file (source of truth for keys + grants; fail-closed at boot)
BANKING_API_CONFIG_PATH=/etc/banking-api/config.json

# Requests/min per key. Code default is 600 — do not raise this to disable the
# limit; if the E2E stack ever needs a higher ceiling, set it there, not here.
RATE_LIMIT_PER_MINUTE=600
