{
  "name": "@slimfact/banking-api",
  "version": "0.1.3",
  "private": true,
  "description": "SlimFact banking proxy — owns the open-banking.io sync and exposes granted bank data to machine clients over tRPC",
  "author": "simsustech",
  "type": "module",
  "exports": {
    "./trpc": {
      "types": "./src/trpc/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./config": {
      "types": "./src/config/index.ts",
      "import": "./src/config/index.ts"
    },
    "./events": {
      "types": "./src/events.ts",
      "import": "./src/events.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "node ./dist/src/server.js",
    "migrate:latest": "node ./dist/src/kysely/migrate.js",
    "seed:test": "node ./dist/src/seed/test.js",
    "generate-key": "node ./dist/scripts/generate-key.js",
    "bootstrap-config": "node ./dist/scripts/bootstrap-config.js",
    "add-key": "node ./dist/scripts/add-key.js",
    "list-accounts": "node ./dist/scripts/list-accounts.js",
    "list-keys": "node ./dist/scripts/list-keys.js",
    "prune-connections": "node ./dist/scripts/prune-connections.js",
    "seed:demo": "node ./dist/src/seed/demo.js",
    "lint": "oxlint src scripts",
    "lint:fix": "oxlint src scripts --fix",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write ."
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.4",
    "@modular-api/event-bus": "0.2.4",
    "@open-banking-io/client": "1.3.0",
    "@slimfact/tools": "workspace:*",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@vitrify/tools": "0.5.5",
    "fastify": "5.12.7",
    "kysely": "0.29.7",
    "mollie-api-typescript": "1.12.44",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "stripe": "^23.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5",
    "ws": "8.22.0"
  }
}
