database
database/*
node_modules
.git
.pi
.dump
.env
# Never bake credentials, API-key configs or real client data into an image
# (the Dockerfile does `COPY . .` into the build stage).
env
config
*.dump.json
*.dump.sql
.backup
failure_memories.txt

# Build output is produced inside the build stage. A bare `dist` only matched the
# context root, so stale artifacts under packages/*/dist still leaked in via
# `COPY . .` and survived the rebuild (tsc adds, never prunes).
**/dist
**/dist/**
